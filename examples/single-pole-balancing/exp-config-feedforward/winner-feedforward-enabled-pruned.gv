digraph {
	node [fontsize=9 height=0.2 shape=circle width=0.2]
	x [fillcolor=lightgray shape=box style=filled]
	dx [fillcolor=lightgray shape=box style=filled]
	theta [fillcolor=lightgray shape=box style=filled]
	dtheta [fillcolor=lightgray shape=box style=filled]
	control [fillcolor=lightblue style=filled]
	dtheta -> control [color=green penwidth=0.8003402622036955 style=solid]
	x -> control [color=green penwidth=0.1685458325421061 style=solid]
	theta -> control [color=green penwidth=0.3684787374408718 style=solid]
	dx -> control [color=green penwidth=0.43401467989665243 style=solid]
}
